# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of frontend origins allowed to call this API
# (the admin dashboard and the storefront each run on their own port)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174

# Database (PostgreSQL)
DATABASE_URL="postgresql://itmart_user:itmart_password@localhost:5432/itmart_db?schema=public"

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Admin WhatsApp number that will receive order messages (international format, no + or spaces)
# Example for Cameroon: 237677123456
ADMIN_WHATSAPP_NUMBER=237600000000

# Admin email address that will receive a copy of every new order notification
ADMIN_EMAIL=admin@itmart.cm

# Email (Nodemailer) - use e.g. Gmail App Password, Mailtrap, SendGrid SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="IT Mart <no-reply@itmart.cm>"

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Products at or below this stock level are flagged as "low stock" on the
# admin dashboard, and trigger an email alert when a manual stock update
# crosses this threshold.
LOW_STOCK_THRESHOLD=5
