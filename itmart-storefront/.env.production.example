# =====================================================================
# IT Mart storefront — PRODUCTION settings (copy to ".env.production"
# ON THE SERVER, before running "npm run build").
# These values are built into the site: rebuild after changing them.
# Replace every "votre-domaine.com" with your real domain.
# =====================================================================

NEXT_PUBLIC_API_URL=https://api.votre-domaine.com/api
NEXT_PUBLIC_API_ORIGIN=https://api.votre-domaine.com
NEXT_PUBLIC_SITE_URL=https://votre-domaine.com

NEXT_PUBLIC_WHATSAPP_NUMBER=2376XXXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
NEXT_PUBLIC_CONTACT_PHONE=+237 6XX XXX XXX
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Tracking (see TRACKING.md) — empty = off
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_REQUIRE_TRACKING_CONSENT=true
