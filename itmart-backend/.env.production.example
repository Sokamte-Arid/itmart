# =====================================================================
# IT Mart backend — PRODUCTION settings (copy to ".env" ON THE SERVER)
# Replace every "votre-domaine.com" with your real domain.
# Never commit the real .env to GitHub (it's in .gitignore).
# =====================================================================

NODE_ENV=production
PORT=5000

# Read the real visitor address from Nginx (same server). Keep as is.
TRUST_PROXY=loopback

# Sites allowed to call this API: the shop and the admin (comma-separated, no spaces)
ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com,https://admin.votre-domaine.com

# Address of the admin (used in password-reset emails)
ADMIN_URL=https://admin.votre-domaine.com

# Database on the server (the deployment guide creates this user/password)
DATABASE_URL="postgresql://itmart_user:A_STRONG_DB_PASSWORD@localhost:5432/itmart_db?schema=public"

# Login tokens. Generate a NEW long random value for production — run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# and paste the result here. Changing it later logs every admin out.
JWT_SECRET=PASTE_THE_GENERATED_VALUE_HERE
JWT_EXPIRES_IN=7d

# WhatsApp number that receives orders (country code + number, no + or spaces)
ADMIN_WHATSAPP_NUMBER=2376XXXXXXXX
# Email that receives a copy of every new order
ADMIN_EMAIL=you@example.com

# Sending emails (Gmail: use an "App password", not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_letter_app_password
SMTP_FROM="IT Mart <you@gmail.com>"

# Uploaded images (kept on the server's disk — include this folder in backups)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

LOW_STOCK_THRESHOLD=5

# Phone notifications. You can reuse the keys from your PC's .env
# (admins then just turn notifications on again from the live app).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Invoices
COMPANY_NAME=IT Mart
COMPANY_ADDRESS=
COMPANY_CITY=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_NIU=
COMPANY_RCCM=
COMPANY_LOGO=uploads/brand/logo.png
INVOICE_VAT_RATE=0
PROFORMA_VALIDITY_DAYS=15
INVOICE_FOOTER=
