# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of frontend origins allowed to call this API
# (the admin dashboard and the storefront each run on their own port)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5174

# Database (PostgreSQL)
DATABASE_URL="postgresql://itmart_user:itmart_password@localhost:5432/itmart_db?schema=public"

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Admin WhatsApp number that will receive order messages (international format, no + or spaces)
# Example for Cameroon: 237677123456
ADMIN_WHATSAPP_NUMBER=237600000000

# Admin email address that will receive a copy of every new order notification
ADMIN_EMAIL=admin@itmart.cm

# Email (Nodemailer) - use e.g. Gmail App Password, Mailtrap, SendGrid SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="IT Mart <no-reply@itmart.cm>"

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Products at or below this stock level are flagged as "low stock" on the
# admin dashboard, and trigger an email alert when a manual stock update
# crosses this threshold.
LOW_STOCK_THRESHOLD=5

# Push notifications for the admin mobile app (Web Push / VAPID).
# Generate a key pair ONCE with:  npm run push:keys
# then paste the two keys below. Keep the private key secret, and don't
# change the keys later (existing subscriptions would stop working).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@itmart.cm

# Invoices & proformas (PDF from the admin, "Télécharger la facture")
# Your company details as they must appear on invoices.
COMPANY_NAME=IT Mart
COMPANY_ADDRESS=Rue ..., Quartier ...
COMPANY_CITY=Yaoundé
COMPANY_PHONE=+237 6XX XX XX XX
COMPANY_EMAIL=contact@itmart.cm
COMPANY_NIU=
COMPANY_RCCM=
# Path to your logo, relative to the backend folder (PNG, JPG, WebP or SVG), e.g. uploads/brand/logo.png
COMPANY_LOGO=
# VAT rate in %. Leave 0 if you are not subject to VAT: invoices then show a
# single total. With e.g. 19.25, prices are treated as VAT-inclusive (TTC)
# and each invoice shows Total HT / TVA / Total TTC. Check with your accountant.
INVOICE_VAT_RATE=0
# How many days a proforma stays valid
PROFORMA_VALIDITY_DAYS=15
# Optional text at the bottom of each page (defaults to name + NIU + RCCM)
INVOICE_FOOTER=

# Online behind Nginx on the same server: leave as loopback (default).
# Read the real visitor address so per-visitor limits work. See DEPLOYMENT notes.
TRUST_PROXY=loopback
